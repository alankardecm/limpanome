{
    "name": "Limpa Nome - Follow-Up Automático (Dia 1, 3, 7)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 10 * * *"
                        }
                    ]
                }
            },
            "id": "flu-0001-0001-0001-000000000001",
            "name": "Cron - Todos os dias 10h",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                240,
                300
            ]
        },
        {
            "parameters": {
                "url": "=https://SEU_SUPABASE_URL.supabase.co/rest/v1/clientes?status=eq.lead&origem=eq.landing_page&select=id,nome,telefone,data_cadastro&order=data_cadastro.desc",
                "authentication": "none",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "SUA_SUPABASE_ANON_KEY"
                        },
                        {
                            "name": "Authorization",
                            "value": "Bearer SUA_SUPABASE_ANON_KEY"
                        }
                    ]
                },
                "options": {
                    "response": {
                        "response": {
                            "responseFormat": "json"
                        }
                    }
                }
            },
            "id": "flu-0002-0002-0002-000000000002",
            "name": "Buscar Leads do Supabase",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                460,
                300
            ]
        },
        {
            "parameters": {
                "functionCode": "const leads = $input.all().map(i => i.json);\nconst flat = Array.isArray(leads[0]) ? leads[0] : leads;\nconst agora = new Date();\nconst resultados = [];\n\nfor (const lead of flat) {\n  if (!lead.telefone) continue;\n  \n  const cadastro = new Date(lead.data_cadastro);\n  const diffDias = Math.floor((agora - cadastro) / (1000 * 60 * 60 * 24));\n  \n  let mensagem = null;\n  let etapa = null;\n  \n  if (diffDias === 1) {\n    etapa = 'dia_1';\n    mensagem = `Olá, ${lead.nome}! 😊\\n\\nVocê se cadastrou ontem para a consulta gratuita sobre blindagem do seu nome. Nossa equipe já está analisando sua situação nos birôs de crédito!\\n\\nSe tiver alguma dúvida, pode nos chamar. Estamos aqui para te ajudar!\\n\\n_Amarilis Soluções_`;\n  } else if (diffDias === 3) {\n    etapa = 'dia_3';\n    mensagem = `Oi, ${lead.nome}! 👋\\n\\nJá faz 3 dias que você solicitou a consulta. Gostaria de dar continuidade à blindagem do seu nome?\\n\\nCom a *liminar judicial*, seu nome sai dos birôs de crédito por até *12 meses*, te dando fôlego para reorganizar suas finanças.\\n\\nResponda esta mensagem e vamos conversar!\\n\\n_Amarilis Soluções_`;\n  } else if (diffDias === 7) {\n    etapa = 'dia_7';\n    mensagem = `${lead.nome}, tudo bem? 🤝\\n\\nFaz uma semana que você demonstrou interesse na blindagem do seu nome. Não queremos que perca essa oportunidade!\\n\\n⚖️ Processo 100% legal via CDC\\n🛡️ Nome limpo por até 12 meses\\n\\nResponda *SIM* se quiser saber mais ou *NÃO* se não tiver mais interesse. Respeitamos sua decisão! 😊\\n\\n_Amarilis Soluções_`;\n  }\n  \n  if (mensagem) {\n    let tel = lead.telefone.replace(/\\D/g, '');\n    if (!tel.startsWith('55')) tel = '55' + tel;\n    resultados.push({\n      json: {\n        cliente_id: lead.id,\n        nome: lead.nome,\n        telefone: tel,\n        etapa: etapa,\n        mensagem: mensagem\n      }\n    });\n  }\n}\n\nreturn resultados.length > 0 ? resultados : [{ json: { skip: true } }];"
            },
            "id": "flu-0003-0003-0003-000000000003",
            "name": "Filtrar por Dia e Montar Mensagem",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                700,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "check-skip",
                            "leftValue": "={{ $json.skip }}",
                            "rightValue": "true",
                            "operator": {
                                "type": "boolean",
                                "operation": "notTrue"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "flu-0004-0004-0004-000000000004",
            "name": "Tem Leads?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                940,
                300
            ]
        },
        {
            "parameters": {
                "amount": "={{ Math.floor(Math.random() * 10) + 5 }}",
                "unit": "seconds"
            },
            "id": "flu-0005-0005-0005-000000000005",
            "name": "Delay Aleatório (5-15s)",
            "type": "n8n-nodes-base.wait",
            "typeVersion": 1.1,
            "position": [
                1160,
                220
            ]
        },
        {
            "parameters": {
                "url": "=https://graph.facebook.com/v19.0/SEU_PHONE_NUMBER_ID/messages",
                "authentication": "none",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer SEU_ACCESS_TOKEN_META"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "bodyContentType": "json",
                "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $json.mensagem }}\"\n  }\n}",
                "options": {}
            },
            "id": "flu-0006-0006-0006-000000000006",
            "name": "Enviar WhatsApp Follow-Up",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1380,
                220
            ]
        },
        {
            "parameters": {
                "url": "=https://SEU_SUPABASE_URL.supabase.co/rest/v1/historico",
                "authentication": "none",
                "method": "POST",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "apikey",
                            "value": "SUA_SUPABASE_ANON_KEY"
                        },
                        {
                            "name": "Authorization",
                            "value": "Bearer SUA_SUPABASE_ANON_KEY"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "Prefer",
                            "value": "return=minimal"
                        }
                    ]
                },
                "sendBody": true,
                "bodyContentType": "json",
                "jsonBody": "={\n  \"cliente_id\": {{ $('Filtrar por Dia e Montar Mensagem').item.json.cliente_id }},\n  \"tipo\": \"follow_up\",\n  \"descricao\": \"Follow-up automático ({{ $('Filtrar por Dia e Montar Mensagem').item.json.etapa }}) enviado via WhatsApp\",\n  \"usuario\": \"n8n-followup\"\n}",
                "options": {}
            },
            "id": "flu-0007-0007-0007-000000000007",
            "name": "Registrar no Histórico CRM",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1600,
                220
            ]
        },
        {
            "parameters": {},
