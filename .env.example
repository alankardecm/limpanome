# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...sua_anon_key_aqui

# WhatsApp Evolution API
EVOLUTION_API_URL=http://SUA_VPS_IP:8080
EVOLUTION_API_KEY=evolution_api_key_change_me
EVOLUTION_INSTANCE_NAME=limpa_nome_instance

# WhatsApp Notificações (número de destino)
NOTIF_WHATSAPP_NUMERO=5519992244838

# ===== Consulta de Crédito =====
# Provider ativo: simulado (default) | bigdatacorp | assertiva
# Sem credenciais do provider escolhido, cai automaticamente para 'simulado'.
CREDITO_PROVIDER=simulado

# BigDataCorp (quando CREDITO_PROVIDER=bigdatacorp)
BIGDATACORP_TOKEN_ID=
BIGDATACORP_ACCESS_TOKEN=
BIGDATACORP_DATASETS=basic_data,financial_risk

# Assertiva (quando CREDITO_PROVIDER=assertiva)
ASSERTIVA_CLIENT_ID=
ASSERTIVA_CLIENT_SECRET=
ASSERTIVA_BASE_URL=https://api.assertivasolucoes.com.br
