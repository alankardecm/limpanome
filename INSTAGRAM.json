    {
      "parameters": {
        "functionCode": "const query = $input.first().json.query || {};\nconst challenge = query['hub.challenge'] || '';\nreturn [{ json: { \"hub.challenge\": challenge } }];"
      },
      "id": "ffd1f5a8-607c-4d44-bcbe-fd7f0fbf5fe0",
      "name": "Extrair Challenge",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        32,
        48
      ],
      "disabled": true
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/plain"
              }
            ]
          }
        }
      },
      "id": "c17aaa5c-52b0-4473-a53d-079ff5fa25cf",
      "name": "Responder Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        352,
        272
      ]
    },
    {
      "parameters": {
        "functionCode": "const body = $input.first().json.body;\nconst results = [];\n\nfunction normalizar(texto) {\n  if (!texto) return \"\";\n  return texto\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '');\n}\n\nif (body && body.entry) {\n  for (const entry of body.entry) {\n    const bot_id = entry.id; // Captura o ID da sua própria conta do Instagram\n    const messaging = entry.messaging || [];\n    \n    for (const msg of messaging) {\n      // Regra anti-loop: ignora se quem enviou a mensagem foi o próprio bot\n      if (msg.sender && msg.sender.id === bot_id) {\n        continue;\n      }\n      \n      // Se for uma mensagem de texto de um usuário real, extrai os dados\n      if (msg.message && msg.message.text) {\n        results.push({\n          sender_id: msg.sender.id,\n          message_text: msg.message.text,\n          message_normalizado: normalizar(msg.message.text)\n        });\n      }\n    }\n  }\n}\n\n// Retorno de segurança para manter o webhook vivo em eventos vazios\nif (results.length === 0) {\n  return [{\n    sender_id: \"ignorar\",\n    message_text: \"\",\n    message_normalizado: \"\"\n  }];\n}\n\nreturn results;"
      },
      "id": "cc36d706-0b43-47bb-bd0f-14fcd1051174",
